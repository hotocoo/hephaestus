# Hephaestus example environment configuration.
# Copy to .env for local development. NEVER commit real credentials.

# Deployment environment: development | test | staging | production
HEPHAESTUS_ENVIRONMENT=development

# PostgreSQL connection string (credentials may be embedded here)
HEPHAESTUS_DATABASE_URL=postgres://localhost/hephaestus_dev

# API server bind address/port
HEPHAESTUS_BIND_ADDR=127.0.0.1
HEPHAESTUS_PORT=7300

# Artifact/evidence storage root
HEPHAESTUS_STORAGE_ROOT=.hephaestus/data

# Telemetry
HEPHAESTUS_LOG_LEVEL=info
# HEPHAESTUS_OTLP_ENDPOINT=http://localhost:4318
