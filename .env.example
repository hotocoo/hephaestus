# Hephaestus example environment configuration.
# Copy to .env for local development. NEVER commit real credentials.

# Deployment environment: development | test | staging | production
HEPHAESTUS_ENVIRONMENT=development

# PostgreSQL connection string (credentials may be embedded here)
HEPHAESTUS_DATABASE_URL=postgres://localhost/hephaestus_dev

# API server bind address/port
HEPHAESTUS_BIND_ADDR=127.0.0.1
HEPHAESTUS_PORT=7300

# Artifact/evidence storage root
HEPHAESTUS_STORAGE_ROOT=.hephaestus/data

# Telemetry
HEPHAESTUS_LOG_LEVEL=info
# HEPHAESTUS_OTLP_ENDPOINT=http://localhost:4318

# Worker identity and queues (hephaestus-worker).
# Defaults serve deterministic queues only; model-backed stages
# (planning, implementation, review) require [model] settings below.
# HEPHAESTUS_WORKER_ID=worker-laptop-1
# HEPHAESTUS_WORKER_QUEUES=analysis,verification,build

# Model provider for model-backed queues (worker processes only;
# the API server never holds these credentials).
# HEPHAESTUS_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# HEPHAESTUS_MODEL_API_KEY=change-me
# HEPHAESTUS_MODEL_NAME=forge-large

# --- Web tier (packages/*) ---
# Live conformance suites spawn the real server binary against this
# database; SDK type generation uses it too.
HEPHAESTUS_TEST_DATABASE_URL=postgres://localhost/hephaestus_test
# Optional explicit path to the server binary used by TS harnesses:
# HEPHAESTUS_SERVER_BIN=target/debug/hephaestus-server
